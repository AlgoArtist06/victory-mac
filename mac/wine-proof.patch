diff --git a/crates/victory-hle/src/modules/files.rs b/crates/victory-hle/src/modules/files.rs
index 9a06b4b..fa3bc83 100644
--- a/crates/victory-hle/src/modules/files.rs
+++ b/crates/victory-hle/src/modules/files.rs
@@ -54,7 +54,7 @@ pub fn mount(root: &Path) -> Option<char> {
         return char::from_u32(letter.into());
     }
     // SAFETY: no arguments.
-    let host = unsafe { GetLogicalDrives() };
+    let host = (1u32 << 2 | 1 << 25) /* WINE-PROOF-ONLY: GetLogicalDrives hangs under Wine here */;
