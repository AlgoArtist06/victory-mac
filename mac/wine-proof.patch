     })?;
@@ -75,7 +75,7 @@ pub fn mount_at(letter: char, root: &Path) {
         return;
     };
     // SAFETY: no arguments.
-    let hides_host_drive = unsafe { GetLogicalDrives() } >> index & 1 != 0;
+    let hides_host_drive = (1u32 << 2 | 1 << 25) /* WINE-PROOF-ONLY: GetLogicalDrives hangs under Wine here */ >> index & 1 != 0;
     tracing::info!(drive = %letter, root = %root.display(), hides_host_drive, "virtual drive");
     let mut drives = drives();
     drives.retain(|(l, _)| u32::from(*l) != u32::from(letter));
diff --git a/crates/victory-hle/src/modules/xmem.rs b/crates/victory-hle/src/modules/xmem.rs
